# ── Payload ──────────────────────────────────────────────────────────────
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
# The site's public address (no trailing slash). Local: http://localhost:3018
NEXT_PUBLIC_SERVER_URL=http://localhost:3018

# ── MongoDB Atlas ────────────────────────────────────────────────────────
# Atlas → Database → Connect → Drivers. Put the database name before the "?".
DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ologe?retryWrites=true&w=majority

# ── Cloudflare R2 (uploads) ──────────────────────────────────────────────
# Leave these empty locally to store uploads in ./media instead.
# R2 → Overview: Account ID. R2 → Manage API tokens → Object Read & Write,
# scoped to the bucket: Access Key ID + Secret Access Key.
R2_ACCOUNT_ID=
R2_BUCKET=ologe-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public URL of the bucket: the r2.dev URL (Settings → Public access) or a
# custom domain such as https://media.ologeofafrica.com. Optional, but without
# it every image is streamed through the app.
R2_PUBLIC_URL=

# ── Paystack (checkout, next step) ───────────────────────────────────────
# Dashboard → Settings → API Keys & Webhooks. Use the test keys until launch.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
